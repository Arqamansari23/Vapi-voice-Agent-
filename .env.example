# ---- API server (set these on Railway) ----
# Railway injects this automatically when you add the Postgres plugin.
# Leave unset locally to use a SQLite file (./patients.db).
DATABASE_URL=
# Shared secret Vapi sends in the X-Vapi-Secret header. Must match the token
# of the Vapi Custom Credential below. Leave empty to disable the check.
VAPI_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=INFO
SEED_DEMO_DATA=true

# ---- Vapi setup script only (python -m vapi_setup.setup_vapi) ----
VAPI_API_KEY=
PUBLIC_BASE_URL=https://your-app.up.railway.app
VAPI_CREDENTIAL_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_VOICE_ID=Elliot
